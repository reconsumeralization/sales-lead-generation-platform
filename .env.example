# Sales Lead Generation Platform Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:8432/sales_platform

# Redis Configuration
REDIS_URL=redis://localhost:8379

# Kafka Configuration
KAFKA_BROKERS=localhost:8092

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Keys - REQUIRED FOR FUNCTIONALITY
OPENAI_API_KEY=your-openai-api-key-here

# CRM Integration Keys
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com

HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret

PIPEDRIVE_API_TOKEN=your-pipedrive-api-token
PIPEDRIVE_COMPANY_DOMAIN=your-company

# Data Enrichment APIs
ZOOMINFO_API_KEY=your-zoominfo-api-key
APOLLO_API_KEY=your-apollo-api-key

# Email Service Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# LinkedIn Integration
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:8200

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Feature Flags
ENABLE_AI_SCORING=true
ENABLE_AUTO_OUTREACH=true
ENABLE_COMPLIANCE_MONITORING=true
ENABLE_ANALYTICS=true