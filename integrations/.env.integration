# GitHub Integration Environment Variables
# For Ron's Florida Solar LLC Repository Connection

# GitHub Configuration
GITHUB_TOKEN=your-github-personal-access-token-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-key-here
GITHUB_INTEGRATION_PORT=9000

# Repository Details
REPO_OWNER=reconsumeralization
REPO_NAME=a-a-ronsFloridaSolarLLC
REPO_URL=https://github.com/reconsumeralization/a-a-ronsFloridaSolarLLC

# Platform Connection
PLATFORM_BASE_URL=http://localhost:8080
PLATFORM_API_TOKEN=your-platform-api-token-here
WEBHOOK_URL=https://your-platform-domain.com/webhooks/github

# Solar Business Configuration
COMPANY_NAME="Ron's Florida Solar LLC"
COMPANY_PHONE="+1-555-SOLAR-FL"
COMPANY_WEBSITE="https://github.com/reconsumeralization/a-a-ronsFloridaSolarLLC"
SOLAR_EXPERT_GITHUB_USERNAME=reconsumeralization

# Integration Settings
SYNC_INTERVAL_MINUTES=5
BATCH_SIZE=50
RETRY_ATTEMPTS=3
AUTO_ASSIGN_ISSUES=true
AUTO_CREATE_LEADS=true
AUTO_RESPOND_TO_INQUIRIES=true

# Webhook Events to Process
PROCESS_PUSH_EVENTS=true
PROCESS_ISSUE_EVENTS=true
PROCESS_PR_EVENTS=true
PROCESS_RELEASE_EVENTS=true
PROCESS_STAR_EVENTS=true

# Lead Processing
LEAD_QUALIFICATION_THRESHOLD=70
AUTO_ROUTE_HOT_LEADS=true
CREATE_GITHUB_ISSUES_FROM_PLATFORM=true

# Notification Settings
SLACK_WEBHOOK_URL=your-slack-webhook-url
EMAIL_NOTIFICATIONS=true
SMS_NOTIFICATIONS=false

# Security
WEBHOOK_SIGNATURE_VERIFICATION=true
API_RATE_LIMITING=true
LOG_LEVEL=info

# Performance Monitoring
ENABLE_METRICS=true
METRICS_PORT=9001
HEALTH_CHECK_INTERVAL=30